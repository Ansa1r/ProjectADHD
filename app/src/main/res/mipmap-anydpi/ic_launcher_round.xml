<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <size android:width="48dp" android:height="48dp" />
            <gradient android:angle="270" android:startColor="@color/startup_top"
                android:centerColor="@color/startup_green" android:centerY="0.48" android:endColor="@color/startup_blue" />
        </shape>
    </item>
    <item android:width="36dp" android:height="36dp" android:gravity="center">
        <bitmap android:src="@drawable/mascot_startup" android:gravity="fill" android:filter="true" />
    </item>
</layer-list>
